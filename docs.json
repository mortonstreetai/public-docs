{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Morton Street OS",
  "description": "One sales operating system across your CRM, sequencers and store, with an MCP server for Claude, ChatGPT and Grok Bot.",
  "colors": {
    "primary": "#111111",
    "light": "#F5F5F5",
    "dark": "#0A0A0A"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://mortonstreet.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://status.mortonstreet.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open portal",
      "href": "https://app.mortonstreet.ai"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "introduction",
          "quickstart"
        ]
      },
      {
        "group": "Connect your AI",
        "pages": [
          "connect/custom-connector",
          "connect/claude",
          "connect/chatgpt",
          "connect/grok-bot"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/authentication",
          "concepts/workspaces",
          "concepts/data-model",
          "concepts/guardrails"
        ]
      },
      {
        "group": "Playbooks",
        "pages": [
          "playbooks/rfq-to-autoquote"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/overview",
          "integrations/hubspot",
          "integrations/salesforce",
          "integrations/shopify",
          "integrations/odoo",
          "integrations/instantly",
          "integrations/smartlead",
          "integrations/heyreach"
        ]
      },
      {
        "group": "MCP tool reference",
        "pages": [
          "mcp/overview",
          "mcp/workspace",
          "mcp/read",
          "mcp/write",
          "mcp/odoo",
          "mcp/workflows",
          "mcp/approvals"
        ]
      },
      {
        "group": "Trust",
        "pages": [
          "security"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://mortonstreet.ai"
    },
    "links": [
      {
        "header": "Morton Street",
        "items": [
          {
            "label": "Portal",
            "href": "https://app.mortonstreet.ai"
          },
          {
            "label": "Status",
            "href": "https://status.mortonstreet.ai"
          },
          {
            "label": "Website",
            "href": "https://mortonstreet.ai"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "mcp"
    ]
  },
  "redirects": [
    {
      "source": "/connect/grok",
      "destination": "/connect/grok-bot"
    },
    {
      "source": "/connect/claude-code",
      "destination": "/connect/custom-connector"
    },
    {
      "source": "/connect/cursor",
      "destination": "/connect/custom-connector"
    }
  ]
}
