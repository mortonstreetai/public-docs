{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Morton Street OS",
  "description": "One sales operating system across your CRM, sequencers and store, with an MCP server for Claude, ChatGPT and Cursor.",
  "colors": {
    "primary": "#111111",
    "light": "#F5F5F5",
    "dark": "#0A0A0A"
  },
  "appearance": { "default": "dark", "strict": false },
  "fonts": { "family": "Inter" },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://mortonstreet.ai"
  },
  "navbar": {
    "links": [
      { "label": "Status", "href": "https://status.mortonstreet.ai" }
    ],
    "primary": { "type": "button", "label": "Open portal", "href": "https://app.mortonstreet.ai" }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["introduction", "quickstart"]
      },
      {
        "group": "Connect your AI",
        "pages": ["connect/claude", "connect/chatgpt", "connect/claude-code", "connect/cursor"]
      },
      {
        "group": "Concepts",
        "pages": ["concepts/authentication", "concepts/workspaces", "concepts/data-model", "concepts/guardrails"]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/overview",
          "integrations/hubspot",
          "integrations/salesforce",
          "integrations/shopify",
          "integrations/odoo",
          "integrations/instantly",
          "integrations/smartlead",
          "integrations/heyreach"
        ]
      },
      {
        "group": "MCP tool reference",
        "pages": ["mcp/overview", "mcp/workspace", "mcp/read", "mcp/write", "mcp/workflows", "mcp/approvals"]
      },
      {
        "group": "Trust",
        "pages": ["security"]
      }
    ]
  },
  "footer": {
    "socials": { "website": "https://mortonstreet.ai" },
    "links": [
      {
        "header": "Morton Street",
        "items": [
          { "label": "Portal", "href": "https://app.mortonstreet.ai" },
          { "label": "Status", "href": "https://status.mortonstreet.ai" },
          { "label": "Website", "href": "https://mortonstreet.ai" }
        ]
      }
    ]
  },
  "contextual": { "options": ["copy", "view", "claude", "chatgpt", "cursor", "mcp"] }
}
